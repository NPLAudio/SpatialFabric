{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SpatialFabric scene context, version 1",
  "type": "object",
  "required": ["schema", "schema_version", "space", "objects"],
  "properties": {
    "schema": {"const": "org.nplaudio.spatialfabric.context"},
    "schema_version": {"const": 1},
    "space": {"const": "canonical"},
    "name": {"type": "string", "maxLength": 256},
    "objects": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "required": ["id", "kind", "position"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9_./:-]{1,128}$"},
          "kind": {"enum": ["box", "sphere", "point", "listener"]},
          "label": {"type": "string", "maxLength": 256},
          "position": {"$ref": "#/$defs/vector"},
          "half_extents": {"$ref": "#/$defs/extent"},
          "radius": {"type": "number", "minimum": 0, "maximum": 64},
          "yaw_degrees": {"type": "number", "minimum": -360, "maximum": 360}
        },
        "allOf": [
          {"if": {"properties": {"kind": {"const": "box"}}}, "then": {"required": ["half_extents"]}},
          {"if": {"properties": {"kind": {"const": "sphere"}}}, "then": {"required": ["radius"]}}
        ]
      }
    }
  },
  "$defs": {
    "vector": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "minimum": -64, "maximum": 64}},
    "extent": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "minimum": 0, "maximum": 64}}
  }
}
